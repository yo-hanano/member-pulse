{
  "name": "member-pulse-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "gen-schema": "cd ../backend && ./gradlew generateSchema && cp build/generated/schema.graphql ../frontend/app/graphqls/schema.graphql",
    "codegen": "pnpm run gen-schema && graphql-codegen --config codegen.yaml",
    "codegen-http": "graphql-codegen --config codegen.yaml",
    "typecheck": "react-router typegen && tsc",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "fix": "biome format --write . && biome lint --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@heroui/react": "^3.0.5",
    "@heroui/styles": "^3.0.5",
    "@hookform/resolvers": "^5.2.2",
    "@internationalized/date": "^3.12.1",
    "@mantine/core": "^9.2.1",
    "@mantine/form": "^9.2.1",
    "@mantine/hooks": "^9.2.1",
    "@mantine/notifications": "^9.2.1",
    "@react-router/fs-routes": "^7.15.1",
    "@react-router/node": "^7.15.1",
    "clsx": "^2.1.1",
    "graphql": "^16.14.0",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.6",
    "isbot": "^5.1.40",
    "lucide-react": "^1.16.0",
    "nuqs": "^2.8.9",
    "pnpm": "^11.0.9",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-router": "^7.15.1",
    "remix-flat-routes": "^0.8.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.1",
    "@graphql-codegen/typescript-graphql-request": "^7.0.1",
    "@graphql-codegen/typescript-operations": "^6.0.2",
    "@react-router/dev": "^7.15.1",
    "@react-router/remix-routes-option-adapter": "^7.15.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "heroui-cli": "^3.0.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.13"
  }
}

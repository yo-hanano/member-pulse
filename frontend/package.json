{
  "name": "member-pulse-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "gen-schema": "cd ../backend && ./gradlew generateSchema && cp build/generated/schema.graphql ../frontend/app/graphqls/schema.graphql",
    "codegen": "pnpm run gen-schema && graphql-codegen --config codegen.yaml",
    "codegen-http": "graphql-codegen --config codegen.yaml",
    "typecheck": "react-router typegen && tsc",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "fix": "biome format --write . && biome lint --write .",
    "check": "biome check ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.6.0",
    "@mantine/dates": "^9.6.0",
    "@mantine/form": "^9.6.0",
    "@mantine/hooks": "^9.6.0",
    "@mantine/notifications": "^9.6.0",
    "@mantine/nprogress": "^9.6.0",
    "@react-router/fs-routes": "^7.16.0",
    "@react-router/node": "^7.16.0",
    "clsx": "^2.1.1",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "graphql-tag": "^2.12.7",
    "isbot": "^5.2.2",
    "lucide-react": "^1.40.0",
    "nuqs": "^2.10.1",
    "pnpm": "^11.5.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.16.0",
    "remix-flat-routes": "^0.8.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@graphql-codegen/cli": "^7.4.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-graphql-request": "^7.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@react-router/dev": "^7.16.0",
    "@react-router/remix-routes-option-adapter": "^7.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}

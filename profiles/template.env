# プロジェクト全体のプロファイルテンプレートです
# local.env, stg.env, prod.env を作成してください

PROFILE=local

# =========================
# frontend / bff
# =========================
# アプリ側は標準ポートを使う
FRONTEND_PORT="5173"
BFF_PORT="3000"
VITE_BFF_BASE_URL="http://localhost:3000"

# backend と BFF/frontend 間のローカル接続先
QUARKUS_HTTP_PORT="8080"
MP_JWT_VERIFY_PUBLICKEY_LOCATION="http://localhost:3000/.well-known/jwks.json"
APP_FRONTEND_BASE_URL="http://localhost:5173"
BACKEND_GRAPHQL_URL="http://localhost:8080/graphql"
BACKEND_BASE_URL="http://localhost:8080"

# =========================
# migrate
# =========================
LIQUIBASE_COMMAND_URL=jdbc:postgresql://postgres:5432/member_pulse_dev
LIQUIBASE_COMMAND_USERNAME=postgres
LIQUIBASE_COMMAND_PASSWORD=postgres

LIQUIBASE_COMMAND_REFERENCE_URL=jdbc:postgresql://postgres:5432/member_pulse_dev
LIQUIBASE_COMMAND_REFERENCE_USERNAME=postgres
LIQUIBASE_COMMAND_REFERENCE_PASSWORD=postgres

SNAPSHOT_FILE=build/liquibase/baseline-snapshot.json
CHANGE_LOG_AUTHOR=your-name

# =========================
# deploy
# =========================
DEPLOY_USER="appuser"
DEPLOY_HOST="x-server"
DEPLOY_SSH_HOST="${DEPLOY_USER}@${DEPLOY_HOST}"
REMOTE_DIR="/opt/member-pulse"
DEPLOY_ASSET_DIR="stg"
BOOTSTRAP_SSH_PUBKEY_PATH="$HOME/.ssh/id_ed25519.pub"

KAMAL_REGISTRY_HOST="ghcr.io"
KAMAL_REGISTRY_USERNAME="YOUR_GITHUB_USERNAME"
KAMAL_API_IMAGE="YOUR_GITHUB_USERNAME/member-pulse-api"
KAMAL_EDGE_IMAGE="YOUR_GITHUB_USERNAME/member-pulse-edge"
GHCR_KEEP_VERSIONS="3"

# =========================
# terraform
# =========================
TF_VAR_use_localstack=true
TF_VAR_mock_s3_endpoint="http://localstack:4566"
# 実AWSを使う場合だけ設定
# TF_VAR_aws_profile="your-aws-profile"

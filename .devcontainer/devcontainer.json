{
  "name": "member-pulse-devcontainer",
  "dockerComposeFile": [
    "docker-compose.devcontainer.yaml"
  ],
  "service": "devcontainer",
  "remoteUser": "vscode",
  "overrideCommand": false,
  "workspaceFolder": "/workspace",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {},
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": "postgresql-client,locales,pipx,build-essential,autoconf,bison,pkg-config,libssl-dev,zlib1g-dev,libyaml-dev,libreadline-dev,libffi-dev,libgmp-dev,libsqlite3-dev,libbz2-dev,liblzma-dev,rustc,bubblewrap,libasound2t64,libatk-bridge2.0-0,libatk1.0-0,libatspi2.0-0,libcairo2,libcups2,libdbus-1-3,libdrm2,libexpat1,libfontconfig1,libgbm1,libglib2.0-0,libgtk-3-0,libnspr4,libnss3,libpango-1.0-0,libx11-6,libx11-xcb1,libxcb1,libxcomposite1,libxdamage1,libxext6,libxfixes3,libxkbcommon0,libxrandr2,libxrender1,libxshmfence1,fonts-liberation,fonts-noto-color-emoji,xvfb,chromium"
    },
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers-extra/features/zsh-plugins:0": {
      "ohMyZsh": "true",
      "plugins": "gradle ansible terraform zsh-autosuggestions zsh-syntax-highlighting",
      "omzPlugins": "https://github.com/zsh-users/zsh-autosuggestions.git https://github.com/zsh-users/zsh-syntax-highlighting.git",
      "theme": "clean"
    }
  },
  "forwardPorts": [
    8080,
    3000,
    5173
  ],
  "portsAttributes": {
    "3000": {
      "label": "BFF (Hono)",
      "onAutoForward": "notify",
      "elevateIfNeeded": false,
      "requireLocalPort": false,
      "protocol": "http"
    },
    "5173": {
      "label": "Frontend (Vite)",
      "onAutoForward": "notify",
      "elevateIfNeeded": false,
      "requireLocalPort": false,
      "protocol": "http"
    },
    "8080": {
      "label": "Quarkus API",
      "onAutoForward": "notify",
      "elevateIfNeeded": false,
      "requireLocalPort": false,
      "protocol": "http"
    }
  },
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/workspace/juku-ops,target=/workspace/ref/juku-ops,type=bind,consistency=cached",
    "source=${localEnv:HOME}/workspace/markeman,target=/workspace/ref/markeman,type=bind,consistency=cached"
  ],
  "containerEnv": {
    "GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
    "MISE_GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}"
  },
  "postCreateCommand": "/bin/bash /workspace/.devcontainer/scripts/post-create.sh",
  "postStartCommand": "/bin/bash /workspace/.devcontainer/scripts/post-start.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "java.import.generatesMetadataFilesAtProjectRoot": false,
        "terminal.integrated.defaultProfile.linux": "zsh",
        "files.exclude": {
          "**/.project": true,
          "**/.classpath": true,
          "**/.factorypath": true,
          "**/.settings": true
        },
        "files.watcherExclude": {
          "**/target/**": true,
          "**/node_modules/**": true,
          "**/build/**": true
        }
      },
      "extensions": [
        "vscjava.vscode-java-pack",
        "redhat.java",
        "redhat.vscode-quarkus",
        "redhat.vscode-yaml",
        "tamasfe.even-better-toml",
        "usernamehw.errorlens",
        "editorconfig.editorconfig",
        "mhutchie.git-graph",
        "arturock.gitstash",
        "github.vscode-github-actions",
        "openai.chatgpt",
        "vscode-icons-team.vscode-icons",
        "expo.vscode-expo-tools",
        "bierner.markdown-mermaid",
        "yoavbls.pretty-ts-errors",
        "johnpapa.vscode-peacock",
        "graphql.vscode-graphql-syntax",
        "mechatroner.rainbow-csv"
      ]
    }
  }
}
